generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskType {
  feature
  fix
  hotfix
  bugfix
  release
}

model Repository {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(255)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  pull_requests PullRequest[]

  @@map("repositories")
}

model User {
  id         Int      @id @default(autoincrement())
  username   String   @unique @db.VarChar(100)
  disabled   Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  pull_requests PullRequest[]
  reviews       PullRequestReview[]

  @@map("users")
}

model PullRequest {
  id            Int      @id @default(autoincrement())
  number        Int
  repository_id Int
  branch        String   @db.VarChar(255)
  creator_id    Int
  created_at    DateTime
  inserted_at   DateTime @default(now())

  creator    User       @relation(fields: [creator_id], references: [id])
  repository Repository @relation(fields: [repository_id], references: [id])

  reviews PullRequestReview[]

  @@unique([number, repository_id], map: "uq_pr_repo")
  @@index([repository_id], map: "idx_pr_repository_id")
  @@index([creator_id], map: "idx_pr_creator_id")
  @@index([created_at(sort: Desc)], map: "idx_pr_created_at")
  @@map("pull_requests")
}

model PullRequestReview {
  id              Int       @id @default(autoincrement())
  pull_request_id Int
  task_type       TaskType?
  reviewer_id     Int?
  note            String?
  approved_at     DateTime?
  reviewed_at     DateTime?
  inserted_at     DateTime  @default(now())

  reviewer     User?       @relation(fields: [reviewer_id], references: [id], onDelete: SetNull)
  pull_request PullRequest @relation(fields: [pull_request_id], references: [id], onDelete: Cascade)

  @@index([pull_request_id], map: "idx_prr_pull_request_id")
  @@index([reviewer_id], map: "idx_prr_reviewer_id")
  @@index([task_type], map: "idx_prr_task_type")
  @@map("pull_request_reviews")
}
